# ==============================================================================
# Autonomous Open-Source Contributor Configuration
# Copy this file to .env and customize for your environment.
# ==============================================================================

# Directory where open-source contribution repositories and ledgers are stored
CONTRIBUTIONS_DIR="/Volumes/Disk D/Projects/Others/Git Contributions"

# ntfy.sh topic used for 1-tap phone push notifications (Approve / Reject)
# Install ntfy app on iOS/Android and subscribe to this topic
NTFY_TOPIC="your-unique-contributor-topic"

# GitHub Personal Access Token (or GitHub CLI OAuth token)
# Ensure scopes include: repo, read:org, gist, workflow
GH_TOKEN="gho_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Antigravity project ID (optional, for project grouping in Antigravity)
ANTIGRAVITY_PROJECT_ID="your-project-uuid-here"

# Path to Google Cloud OAuth client credentials and preserved token
GCP_CREDENTIALS_PATH="" # Defaults to ./credentials.json or ~/.config/oss-contributor/credentials.json
GCP_TOKEN_PATH=""       # Defaults to ./token.json or ~/.config/oss-contributor/token.json
